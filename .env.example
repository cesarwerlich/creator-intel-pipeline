APP_ENV=development
LOG_LEVEL=info

# Direct Supabase Connection string (PostgreSQL)
# e.g., postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Supabase REST API settings used by src/db.ts
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Playwright Browser profile session sharing (macOS default path)
# e.g., /Users/[your-username]/Library/Application Support/Google/Chrome/
CHROME_PROFILE_PATH=""

# OpenRouter (for tag classification & LLM summarization)
OPENROUTER_API_KEY=""

# Telegram client API exporter.
# Create API credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_PHONE=""
TELEGRAM_SESSION=""
